#!/usr/bin/env bash
# Mentar secret safeguard — blocks commits that include secret files or
# secret-looking content. Version-controlled so it can be shared; activate with:
#   git config core.hooksPath scripts/git-hooks
# Deliberate override for a confirmed false positive:  git commit --no-verify
set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM || true)

# 1) Block secret-like FILENAMES (defends even against `git add -f`).
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example.*) ;;  # templates are allowed
    .env|.env.*|*.env|*.key|*.pem|*.pfx|*.p12|*secret*|*secrets*|\
    config/inference.yaml|config/*.local.*|secrets/*)
      echo "BLOCKED (filename): $f"
      fail=1 ;;
  esac
done <<< "$staged"

# 2) Scan ADDED lines for secret-looking CONTENT.
pat='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{20,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|(api[_-]?key|secret|token|password|passwd|bearer)["'"'"' ]*[:=][ "'"'"']*[A-Za-z0-9_./+-]{12,})'
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example.*|scripts/git-hooks/*|*.md) continue ;;  # templates/hook/docs exempt
  esac
  added=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  if printf '%s\n' "$added" | grep -Eiq "$pat"; then
    echo "BLOCKED (content) in: $f"
    printf '%s\n' "$added" | grep -Ein "$pat" | head -3 | sed 's/^/   /'
    fail=1
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked by Mentar secret safeguard (scripts/git-hooks/pre-commit).
Put secrets in a gitignored file (.env or config/inference.yaml) and reference
them via ${ENV_VAR}. If this is a genuine false positive: git commit --no-verify
MSG
  exit 1
fi

# 3) ruff gate -- AGENTS.md already states "ruff check . clean" as part of
# every change's gate; this just enforces it instead of relying on an agent/
# contributor to remember before committing (2026-07-25, maintainer ask).
# Whole-repo, not staged-files-only, matching that same existing gate
# definition exactly. Skips quietly if ruff isn't installed rather than
# hard-failing a commit over a missing dev dependency.
RUFF=""
if [ -x ".venv/bin/ruff" ]; then
  RUFF=".venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
fi
if [ -n "$RUFF" ]; then
  if ! "$RUFF" check . ; then
    echo "Commit blocked: ruff check . is not clean (see above). Fix or: git commit --no-verify" >&2
    exit 1
  fi
else
  echo "NOTE: ruff not found (.venv/bin/ruff or on PATH) -- skipping the ruff gate this commit." >&2
fi

exit 0
