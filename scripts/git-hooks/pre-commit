#!/usr/bin/env bash
# Mentar secret safeguard — blocks commits that include secret files or
# secret-looking content. Version-controlled so it can be shared; activate with:
#   git config core.hooksPath scripts/git-hooks
# Deliberate override for a confirmed false positive:  git commit --no-verify
set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM || true)

# 1) Block secret-like FILENAMES (defends even against `git add -f`).
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example.*) ;;  # templates are allowed
    .env|.env.*|*.env|*.key|*.pem|*.pfx|*.p12|*secret*|*secrets*|\
    config/inference.yaml|config/*.local.*|secrets/*)
      echo "BLOCKED (filename): $f"
      fail=1 ;;
  esac
done <<< "$staged"

# 2) Scan ADDED lines for secret-looking CONTENT.
#
# 2026-08-16: gh*_/AKIA/hf_/JWT/64-hex added, so this gate covers the same
# credential SHAPES as safety/credential_guard.py. It deliberately does NOT
# reuse that module: credential_guard screens model PROSE, where a bare
# `api_key=` is always suspect, and running it over source flagged 27 of 572
# tracked files (app.py, backend.py, cli/__main__.py) because `api_key=cfg[...]`
# and the env-var NAME MENTAR_VLLM_API_KEY are ordinary code. The keyword branch
# here requires a 12+ char VALUE for that reason -- keep it that way.
# Every pattern below was verified to produce zero hits across all tracked
# files before being added.
pat='(-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{20,}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|gh[pousr]_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|hf_[A-Za-z0-9]{20,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.|[0-9a-f]{64}|(api[_-]?key|secret|token|password|passwd|bearer)["'"'"' ]*[:=][ "'"'"']*[A-Za-z0-9_./+-]{12,})'
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    # *.sha256 is exempt because the 64-hex rule above is exactly a checksum's
    # shape (eval/dataset_v1.sha256). The rule still guards every other file --
    # Mentar's own gateway key is a bare 64-hex string with no prefix to key off.
    *.example.*|scripts/git-hooks/*|*.md|*.sha256) continue ;;  # templates/hook/docs/checksums exempt
  esac
  added=$(git diff --cached -U0 -- "$f" | grep -E '^\+' | grep -vE '^\+\+\+' || true)
  # A line that READS a credential is not a line that LEAKS one. The keyword
  # branch of $pat needs a 12+ char value, and `api_key = os.environ.get(...)`
  # supplies one ("os.environ.get") -- so editing that real line in backend.py
  # blocked the commit (found 2026-08-16). ERE has no negative lookahead, so the
  # code-reference idioms are filtered out here instead. A literal secret has
  # none of them.
  susp=$(printf '%s\n' "$added" | grep -Ei "$pat" | grep -Eiv '(os\.environ|getenv|\.get\(|\$\{)' || true)
  if [ -n "$susp" ]; then
    echo "BLOCKED (content) in: $f"
    printf '%s\n' "$susp" | head -3 | sed 's/^/   /'
    fail=1
  fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

Commit blocked by Mentar secret safeguard (scripts/git-hooks/pre-commit).
Put secrets in a gitignored file (.env or config/inference.yaml) and reference
them via ${ENV_VAR}. If this is a genuine false positive: git commit --no-verify
MSG
  exit 1
fi

# 3) ruff gate -- AGENTS.md already states "ruff check . clean" as part of
# every change's gate; this just enforces it instead of relying on an agent/
# contributor to remember before committing (2026-07-25, maintainer ask).
# Whole-repo, not staged-files-only, matching that same existing gate
# definition exactly. Skips quietly if ruff isn't installed rather than
# hard-failing a commit over a missing dev dependency.
RUFF=""
if [ -x ".venv/bin/ruff" ]; then
  RUFF=".venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
  RUFF="ruff"
fi
if [ -n "$RUFF" ]; then
  if ! "$RUFF" check . ; then
    echo "Commit blocked: ruff check . is not clean (see above). Fix or: git commit --no-verify" >&2
    exit 1
  fi
else
  echo "NOTE: ruff not found (.venv/bin/ruff or on PATH) -- skipping the ruff gate this commit." >&2
fi

# 4) Doc-path gate (2026-08-15). CI ran RED on every push for a day while the
# local suite was green every time: check_doc_paths resolved references against
# the WORKING TREE, so docs naming gitignored-but-locally-present files
# (tools/llm.sh, config/inference.yaml) passed here and failed on a fresh clone.
# The checker now resolves against `git ls-files`, which makes local and CI agree
# -- and running it here means a broken reference costs a commit, not a red main.
# Cheap (~1s, no imports beyond stdlib). Skipped quietly if the file is absent.
if [ -f "src/mentar/tools/check_doc_paths.py" ]; then
  PY=""
  if [ -x ".venv/bin/python" ]; then PY=".venv/bin/python"
  elif command -v python3 >/dev/null 2>&1; then PY="python3"
  fi
  if [ -n "$PY" ] && ! "$PY" src/mentar/tools/check_doc_paths.py; then
    echo "Commit blocked: a doc references a path that is not in the repo (see above)." >&2
    echo "  Fix the reference, or list it in _RUNTIME_ARTIFACTS/_KNOWN_ABSENT/_LOCAL_ONLY_TOOLING." >&2
    echo "  Genuine false positive: git commit --no-verify" >&2
    exit 1
  fi
fi

# 5) CI feedback (2026-08-16, maintainer: "how else will you know that CI is
# broken? There is no feedback mechanism").
#
# The gitleaks job sat RED from 2026-08-14 and nobody noticed for a day, because
# nothing reports a push's outcome anywhere the maintainer looks. Rather than a
# daemon or a notification stack, this reuses the one thing that already runs on
# every commit: it reports the last CI conclusion for this branch.
#
# Deliberately NON-BLOCKING and SILENT WHEN GREEN -- a red run from an earlier
# push must not stop you committing the fix, and a passing run must not add
# noise to every commit. Skipped quietly without gh, offline, or unauthenticated;
# `timeout` keeps a hung network from ever holding up a commit.
if command -v gh >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
  ci=$(timeout 6 gh run list --workflow=ci.yml --branch "$branch" --limit 1 \
         --json status,conclusion,headSha,url,databaseId \
         -q '.[]|"\(.status)\t\(.conclusion)\t\(.headSha[0:7])\t\(.url)\t\(.databaseId)"' 2>/dev/null || true)
  if [ -n "$ci" ]; then
    ci_status=$(printf '%s' "$ci" | cut -f1)
    ci_concl=$(printf '%s' "$ci" | cut -f2)
    ci_sha=$(printf '%s' "$ci" | cut -f3)
    ci_url=$(printf '%s' "$ci" | cut -f4)
    ci_id=$(printf '%s' "$ci" | cut -f5)
    if [ "$ci_status" = "completed" ] && [ "$ci_concl" != "success" ] && [ "$ci_concl" != "skipped" ]; then
      # A billing lapse (or a disabled runner) fails every job in SECONDS without
      # executing a single step, and `gh run list` reports that identically to a
      # genuinely broken build. Measured 2026-08-25: all 30 runs back to 08-21
      # were refused this way, so "CI is failure" had cried wolf for five days --
      # exactly how a real red run gets ignored. Zero total steps == never ran.
      ci_steps=$(timeout 6 gh run view "$ci_id" --json jobs \
                   -q '[.jobs[]|.steps|length]|add' 2>/dev/null || echo "")
      if [ "$ci_steps" = "0" ]; then
        cat >&2 <<MSG

  ────────────────────────────────────────────────────────────────
   CI never RAN on $branch (last run, commit $ci_sha)
   GitHub refused it before any step executed -- almost always a failed
   payment or spending limit, NOT your code. Nothing has been verified
   remotely, so scripts/release_gate.sh is the only check you have.
   $ci_url
  ────────────────────────────────────────────────────────────────
MSG
      else
        cat >&2 <<MSG

  ────────────────────────────────────────────────────────────────
   CI is $ci_concl on $branch (last run, commit $ci_sha)
   $ci_url
   Committing anyway is fine -- this is a heads-up, not a gate.
  ────────────────────────────────────────────────────────────────
MSG
      fi
    fi
  fi
fi

exit 0
