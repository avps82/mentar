#!/usr/bin/env bash
# Mentar pre-push gate — the checks CI runs that pre-commit is too slow to.
# Activate with:  git config core.hooksPath scripts/git-hooks
# Override for a confirmed false positive / an emergency:  git push --no-verify
#
# Why this exists (2026-08-16, maintainer: "how else will you know that CI is
# broken? There is no feedback mechanism"). pre-commit runs ruff + doc-paths +
# a secret scan on staged lines — fast enough for every commit, but it cannot
# catch the two things that actually turned main red:
#
#   * a test failure (CI runs 1008 tests on 3.11/3.12/3.13; the 2026-08-15 red
#     was tests/web/test_progress.py asserting stale picker labels)
#   * a gitleaks finding over FULL HISTORY (pre-commit only sees the staged
#     diff, so a secret already in an earlier commit is invisible to it)
#
# Pushes are far rarer than commits, so paying for these here is affordable in
# a way that paying on every commit is not.
#
# ── CI job -> where it is covered locally (keep this table honest) ───────────
#   CI `test`            -> release_gate.sh steps 1-3 (pytest tests/, a SUPERSET:
#                           CI ignores test_browser_ui.py, the gate does not)
#   CI `browser checks`  -> release_gate.sh step 4, the "must actually run" half;
#                           without it a chromium-less machine goes green having
#                           verified nothing about rendering
#   CI `secrets`         -> release_gate.sh step 5 AND pre-push §2 below (cheap
#                           at ~6s, so it is worth re-running at push time)
#   CI `prompt-eval-…`   -> not gated: it posts a REMINDER comment, not a pass/fail
#   CI `OKF spec still current`
#                        -> not gated here on purpose: it runs on SCHEDULE only,
#                           never on push, and checks an UPSTREAM doc for drift.
#                           A push cannot break it and a hook cannot fix it.
#
# The principle (maintainer, 2026-08-24): "we should not push where we know it
# can fail." So anything CI gates ON PUSH must be gated here first. If a new
# push-triggered CI job appears, it belongs in this table with a local
# counterpart -- or an explicit line saying why it has none.
set -uo pipefail

# Nothing to check on a branch deletion (local sha is all zeros).
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    ''|*[!0]*) only_deletes=0 ;;
  esac
done
[ "$only_deletes" -eq 1 ] && exit 0

PY=""
if [ -x ".venv/bin/python" ]; then PY=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then PY="python3"
fi

# ── 1) The release gate must have PASSED on the commit being pushed ──────────
# NOT the suite itself. `git push` opens the SSH connection BEFORE running this
# hook and transfers over that same connection afterwards, so a 21-minute hook
# leaves it idle until GitHub closes it: the hook passes, then the push dies with
# SIGPIPE and no error. Measured three times on 2026-08-24 -- 1196 tests green,
# gitleaks clean, no transfer, remote unchanged. A slow pre-push hook is not
# slow, it is broken.
#
# So the heavy work lives in scripts/release_gate.sh, which stamps the commit it
# verified. This checks the stamp. Fast, and it still refuses a push nobody has
# validated -- "we should not push where we know it can fail" (maintainer,
# 2026-08-24).
head_sha=$(git rev-parse HEAD 2>/dev/null || echo "")
stamped=$(cat .gate-passed 2>/dev/null || echo "")
if [ -z "$stamped" ]; then
  cat >&2 <<'MSG'

Push blocked: no local gate result found.

  Run the full gate first (~22 min), then push:
      ./scripts/release_gate.sh && git push

  It runs everything CI runs on a push: ruff, doc paths, the whole suite, the
  browser checks (and fails if they SKIP), and gitleaks over full history.
  Genuine emergency: git push --no-verify
MSG
  exit 1
fi
if [ "$stamped" != "$head_sha" ]; then
  cat >&2 <<MSG

Push blocked: the gate passed on a DIFFERENT commit.

    gate passed on : $stamped
    about to push  : $head_sha

  Re-run it on what you are actually pushing:
      ./scripts/release_gate.sh && git push
  Genuine emergency: git push --no-verify
MSG
  exit 1
fi
echo "pre-push: release gate verified for ${head_sha}" >&2

# ── 2) gitleaks, full history ────────────────────────────────────────────────
# Mirrors the CI `secrets` job (same --redact, same repo-wide git scan), so a
# finding costs a push rather than a red main. .gitleaks.toml is picked up
# automatically from the repo root, so the allowlist matches CI exactly.
# Not installed by this hook on purpose: fetching a binary is the operator's
# call, not a git hook's.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "NOTE: gitleaks not installed -- CI will still run it. To gate locally:" >&2
  echo "      https://github.com/gitleaks/gitleaks/releases (v8.30.1 matches CI)" >&2
elif ! gitleaks --help 2>&1 | grep -qE '^[[:space:]]+git[[:space:]]'; then
  # A build without the `git` subcommand predates v8.19 and does NOT agree with
  # CI: measured 2026-08-16, /usr/bin/gitleaks here reports 3 findings that
  # v8.30.1 clears -- the two allowlisted pack keys (it ignores .gitleaks.toml
  # unless passed -c) plus AKIAIOSFODNN7EXAMPLE, which is AWS's own docs example
  # and newer rulesets allowlist. Blocking pushes on findings CI does not have
  # would train you to reach for --no-verify, which is worse than no gate.
  echo "NOTE: local gitleaks is older than CI's v8.30.1 (no 'git' subcommand) and" >&2
  echo "      disagrees with it -- skipping. Upgrade to gate locally:" >&2
  echo "      https://github.com/gitleaks/gitleaks/releases" >&2
elif ! gitleaks git . --no-banner --redact -v; then
  echo "" >&2
  echo "Push blocked: gitleaks found something (see above)." >&2
  echo "  A false positive belongs in .gitleaks.toml, next to the existing" >&2
  echo "  allowlist entry. Genuine emergency: git push --no-verify" >&2
  exit 1
fi

exit 0
